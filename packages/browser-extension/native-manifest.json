{
  "manifest_version": 3,
  "name": "Core CUA",
  "description": "Independent native browser control using reconstructed CUA modules.",
  "version": "0.1.0",
  "key": "",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "debugger",
    "scripting",
    "webNavigation",
    "webRequest",
    "declarativeNetRequest",
    "alarms",
    "nativeMessaging",
    "history",
    "downloads",
    "bookmarks"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
