DEEPSEEK_API_KEY=
# Optional: CUA_MODEL=deepseek-flash
# Optional independent host: JSON array of private endpoint.json paths.
# Requires running @core Chrome extension + com.core.cua host; not auto-installation.
# CORE_CUA_ENDPOINT_FILES=["/absolute/private/core-cua-session/endpoint.json"]
# install:chrome sets this automatically; load the built extension before running demo.
# CORE_CUA_HOST_DIRECTORY="/Users/your-name/.core-cua/endpoints"
# Optional macOS browser-only runtime (requires npm run build:sandbox):
# CUA_RUNTIME_SUPERVISOR=independent
# Optional caller-owned website access approvals; unset means terminal confirmation:
# CUA_AUTO_APPROVE_BROWSER_ORIGINS=https://www.google.com,https://www.baidu.com
# Optional host-only native click routing log. Use an absolute path in an
# existing directory; artifacts/debug/ is ignored by Git. Restart demo to apply.
# CUA_NATIVE_INPUT_LOG=/absolute/path/to/cua-kit/artifacts/debug/native-input.jsonl

# Optional: auto-accept browser/app MCP confirmations (default off).
# CUA_AUTO_APPROVE=1
