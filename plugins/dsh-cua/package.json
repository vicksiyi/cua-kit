{
  "name": "dsh-cua-kit",
  "version": "0.1.0",
  "description": "Connect DeepSeek Harness to cua-kit's restored stdio MCP runtime",
  "type": "module",
  "main": "index.js",
  "exports": "./index.js",
  "files": ["index.js", "src", "scripts", "cordis.patch.yml", "README.md"],
  "engines": { "node": ">=24.9.0", "dsh": "0.2.2-rc.3" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": {
    "setup": "node scripts/setup.js",
    "smoke": "node scripts/smoke.js",
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check src/connection.js && node --check src/config.js",
    "pack:local": "npm pack --pack-destination ../../artifacts"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.3"
  }
}
